  },
  "dependencies": {
    "@dc/env": "*",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dc/config": "*",
    "@types/node": "^22.20.1",
    "convex": "^1.42.3",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3"
  },
  "packageManager": "npm@11.9.0"
}
